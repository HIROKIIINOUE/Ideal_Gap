APP_ENV=dev
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
EXPO_PUBLIC_FIELD_ENCRYPTION_KEY=replace-with-at-least-32-characters

# RevenueCat Public SDK Key (platform-specific, recommended)
EXPO_PUBLIC_REVENUECAT_API_KEY_DEV_IOS=RC_TEST_PUBLIC_SDK_KEY_IOS
EXPO_PUBLIC_REVENUECAT_API_KEY_DEV_ANDROID=RC_TEST_PUBLIC_SDK_KEY_ANDROID
EXPO_PUBLIC_REVENUECAT_API_KEY_PROD_IOS=RC_LIVE_PUBLIC_SDK_KEY_IOS
EXPO_PUBLIC_REVENUECAT_API_KEY_PROD_ANDROID=RC_LIVE_PUBLIC_SDK_KEY_ANDROID

# Backward-compatible fallback (optional)
# If platform-specific keys are missing, app uses these keys.
EXPO_PUBLIC_REVENUECAT_API_KEY_DEV=RC_TEST_PUBLIC_SDK_KEY
EXPO_PUBLIC_REVENUECAT_API_KEY_PROD=RC_LIVE_PUBLIC_SDK_KEY

# Sentry (client/runtime)
# Sent in app runtime. This DSN can be public.
EXPO_PUBLIC_SENTRY_DSN=https://YOUR_PUBLIC_KEY@o000000.ingest.sentry.io/0000000

# Sentry (build/CI secrets for sourcemap upload)
# Do not expose on client. Prefer EAS Secrets.
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
# Optional only for self-hosted Sentry
# SENTRY_URL=https://sentry.io/
